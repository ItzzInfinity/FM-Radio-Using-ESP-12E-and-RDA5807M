<?xml version="1.0" encoding="utf-8"?>
<!-- The radio speaks plain HTTP on the local network (gotcha #13 in the
     architecture proposal). Feasibility build only: allows cleartext to any
     host because the station-mode firmware gets an arbitrary DHCP address.
     The AP-mode app should narrow this to 192.168.4.1. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
