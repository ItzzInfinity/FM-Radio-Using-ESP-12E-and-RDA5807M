// Copy this file to "secrets.h" next to the sketch and fill in your own
// values. "secrets.h" is gitignored, so nothing here ends up on GitHub.
//
//   cp secrets.h.example secrets.h
//
#pragma once

constexpr char WIFI_SSID[]     = "your-wifi-ssid";
constexpr char WIFI_PASSWORD[] = "your-wifi-password";

// Guards both OTA paths (ArduinoOTA and the browser /update form). Without it,
// anyone on your Wi-Fi can replace the firmware.
// Set OTA_PASSWORD to "" to turn authentication off entirely (not recommended).
#define OTA_USERNAME "admin"
#define OTA_PASSWORD "change-me"
